# Required Discord connection settings (never share or commit the real token)
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Discord role IDs. Leave optional roles blank to use database-only progression.
ADMIN_ROLE_ID=
PROFESSOR_ROLE_ID=
MENTOR_ROLE_ID=
STUDENT_ROLE_ID=
GRADUATE_ROLE_ID=
# Major level roles only. Format: level:role_id,level:role_id
LEVEL_ROLE_IDS=

# Channels
UNIVERSITY_CHAT_CHANNEL_ID=
GRADUATION_CHANNEL_ID=
PUBLIC_GRADUATION_ANNOUNCEMENTS=false

# Optional, clearly disclosed partner/referral links
COINBASE_REFERRAL_URL=
TRADINGVIEW_REFERRAL_URL=
BINGX_REFERRAL_URL=

# Application settings
DATABASE_URL=sqlite:///fortune_finance_university.db
DEFAULT_PASSING_SCORE=80
# Allowed values: 0, 5, 15, 30, 60
QUIZ_RETAKE_COOLDOWN_MINUTES=0
CERTIFICATE_OUTPUT_DIRECTORY=certificates
CONTENT_DIRECTORY=content
BACKUP_DIRECTORY=backups
LOG_LEVEL=INFO
ALLOW_STAFF_OVERRIDES=true

# YouTube production credentials are needed only on the private rendering/upload
# computer. Never copy these files into Discord, source control, or the server ZIP.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
